name: Build and deploy
on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-java@v4
        with:
          java-version: '24'      # match your local JDK
          distribution: 'temurin'
      - uses: gradle/actions/setup-gradle@017a9effdb900e5b5b2fddfb590a105619dca3c3 # v4.4.2
      - run: ./gradlew build      # compiles, runs tests, builds the jar

      - name: Upload jar and restart
        env:
          SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
          HOST: ${{ secrets.DEPLOY_HOST }}
        run: |
          mkdir -p ~/.ssh
          echo "$SSH_KEY" > ~/.ssh/id_ed25519 && chmod 600 ~/.ssh/id_ed25519
          ssh-keyscan -H "$HOST" >> ~/.ssh/known_hosts
          scp build/libs/myapp.jar deploy@"$HOST":/var/myapp/myapp.jar.new
          ssh deploy@"$HOST" 'mv /var/myapp/myapp.jar.new /var/myapp/myapp.jar && sudo systemctl restart myapp'
